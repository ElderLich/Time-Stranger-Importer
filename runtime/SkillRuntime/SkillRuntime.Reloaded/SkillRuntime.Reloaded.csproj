<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SkillRuntimeHostFramework Condition="'$(SkillRuntimeHostFramework)' == ''">net9.0</SkillRuntimeHostFramework>
    <TargetFramework>$(SkillRuntimeHostFramework)</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SkillRuntime.Core/SkillRuntime.Core.csproj" />
    <Reference Include="Reloaded.Mod.Interfaces"><HintPath>$(ReloadedInterfacesPath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="RequireExplicitReloadedReference" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ReloadedInterfacesPath)')" Text="Pass ReloadedInterfacesPath to a verified local Reloaded.Mod.Interfaces.dll. No implicit download or live deployment is supported." />
    <GetFileHash Files="$(ReloadedInterfacesPath)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="PinnedReloadedReference" />
    </GetFileHash>
    <Error Condition="'@(PinnedReloadedReference->'%(FileHash)')' != '98B33DF0F380CA7361BFFA9A0328C63C7D96140FC2070D180864FA157F00C88A'" Text="Reloaded interface fingerprint differs from the reviewed 2.5.0 reference. Update dependency evidence before compiling this scaffold against another DLL." />
  </Target>
</Project>
